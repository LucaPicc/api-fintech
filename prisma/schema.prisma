// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int           @id @default(autoincrement())
  name                   String
  email                  String        @unique
  balance                Decimal       @default(0) @db.Decimal(14, 2)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  originatedTransactions Transaction[] @relation("OriginTransactions")
  receivedTransactions   Transaction[] @relation("DestinationTransactions")
}

enum TransactionState {
  pending
  confirmed
  rejected
}

model Transaction {
  id            Int              @id @default(autoincrement())
  originId      Int
  destinationId Int
  amount        Decimal          @db.Decimal(14, 2)
  state         TransactionState @default(pending)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  origin        User             @relation("OriginTransactions", fields: [originId], references: [id])
  destination   User             @relation("DestinationTransactions", fields: [destinationId], references: [id])

  @@index([state])
  @@index([originId])
  @@index([destinationId])
  @@index([originId, createdAt])
  @@index([destinationId, createdAt])
  @@index([originId, state])
  @@index([destinationId, state])
  @@index([state, createdAt])
}
